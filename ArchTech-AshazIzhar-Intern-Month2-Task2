import pandas as pd
import numpy as np
from sklearn.decomposition import TruncatedSVD
from sklearn.metrics import mean_squared_error, mean_absolute_error
from math import sqrt


def main():
    # Load dataset (make sure ratings.csv is in the same folder)
    df = pd.read_csv("ratings.csv")  # columns: userId, movieId, rating

    # Create user-item matrix (rows = users, columns = movies)
    ratings_matrix = df.pivot_table(index="userId", columns="movieId", values="rating").fillna(0)

    # Convert to numpy array
    X = ratings_matrix.values

    # Train/Test Split (masking some ratings as "unseen")
    np.random.seed(42)
    test_mask = (np.random.rand(*X.shape) < 0.2) & (X > 0)  # 20% of existing ratings
    X_train = X.copy()
    X_train[test_mask] = 0  # hide test ratings

    # Apply SVD
    svd = TruncatedSVD(n_components=20, random_state=42)
    X_svd = svd.fit_transform(X_train)
    X_pred = np.dot(X_svd, svd.components_)

    # Evaluate only on test set
    y_true, y_pred = [], []
    for i in range(X.shape[0]):
        for j in range(X.shape[1]):
            if test_mask[i, j]:  # only evaluate hidden ratings
                y_true.append(X[i, j])
                y_pred.append(X_pred[i, j])

    rmse = sqrt(mean_squared_error(y_true, y_pred))
    mae = mean_absolute_error(y_true, y_pred)

    print(f"Final Results -> RMSE: {rmse:.4f}, MAE: {mae:.4f}")


if __name__ == "__main__":
    main()
